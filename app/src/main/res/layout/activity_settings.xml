<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black"
    android:padding="24dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Description -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Add API keys to unlock AI-powered features. The app works without keys using on-device OCR and Android TTS."
            android:textColor="#CCFFFFFF"
            android:textSize="14sp"
            android:layout_marginBottom="24dp" />

        <!-- Claude (Anthropic) section -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Claude API Key (Anthropic)"
            android:textColor="@color/accent"
            android:textSize="16sp"
            android:textStyle="bold"
            android:layout_marginBottom="4dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Smarter OCR cleanup: fixes garbled text, removes headers/footers, detects page numbers automatically."
            android:textColor="#99FFFFFF"
            android:textSize="12sp"
            android:layout_marginBottom="8dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="24dp">

            <EditText
                android:id="@+id/claudeKeyInput"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="sk-ant-..."
                android:textColor="@color/white"
                android:textColorHint="#55FFFFFF"
                android:backgroundTint="@color/primary"
                android:inputType="textPassword"
                android:paddingVertical="12dp"
                android:contentDescription="Claude API key input" />

            <Button
                android:id="@+id/toggleClaudeVisibility"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Show"
                android:textSize="12sp"
                android:layout_marginStart="8dp"
                android:backgroundTint="@color/primary" />

        </LinearLayout>

        <!-- OpenAI section -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="OpenAI API Key"
            android:textColor="@color/accent"
            android:textSize="16sp"
            android:textStyle="bold"
            android:layout_marginBottom="4dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Natural AI voice (tts-1-hd, Nova): much more lifelike reading compared to Android TTS. Sentences are pre-fetched for smooth playback."
            android:textColor="#99FFFFFF"
            android:textSize="12sp"
            android:layout_marginBottom="8dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="32dp">

            <EditText
                android:id="@+id/openaiKeyInput"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="sk-..."
                android:textColor="@color/white"
                android:textColorHint="#55FFFFFF"
                android:backgroundTint="@color/primary"
                android:inputType="textPassword"
                android:paddingVertical="12dp"
                android:contentDescription="OpenAI API key input" />

            <Button
                android:id="@+id/toggleOpenaiVisibility"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Show"
                android:textSize="12sp"
                android:layout_marginStart="8dp"
                android:backgroundTint="@color/primary" />

        </LinearLayout>

        <!-- Action buttons -->
        <Button
            android:id="@+id/saveButton"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:text="Save Keys"
            android:textSize="18sp"
            android:textStyle="bold"
            android:backgroundTint="@color/capture_btn"
            android:layout_marginBottom="12dp"
            android:contentDescription="Save API keys" />

        <Button
            android:id="@+id/clearButton"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="Clear All Keys"
            android:textSize="16sp"
            android:backgroundTint="@color/stop_btn"
            android:contentDescription="Clear all API keys" />

        <!-- Privacy note -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Keys are stored locally on this device only and are never shared."
            android:textColor="#66FFFFFF"
            android:textSize="11sp"
            android:gravity="center"
            android:layout_marginTop="16dp" />

    </LinearLayout>
</ScrollView>
