<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black">

    <!-- Camera Preview fills the screen -->
    <androidx.camera.view.PreviewView
        android:id="@+id/cameraPreview"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/controlPanel"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:scaleType="fillCenter" />

    <!-- Page number overlay top-left -->
    <TextView
        android:id="@+id/pageNumberText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Page --"
        android:textColor="@color/white"
        android:textSize="18sp"
        android:textStyle="bold"
        android:background="@color/status_bg"
        android:paddingHorizontal="12dp"
        android:paddingVertical="6dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginTop="16dp"
        android:layout_marginStart="16dp" />

    <!-- Top-right: voice picker + AI status + listening indicator -->
    <LinearLayout
        android:id="@+id/topRightGroup"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="end"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="12dp"
        android:layout_marginEnd="12dp">

        <Button
            android:id="@+id/voiceButton"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:text="Voice"
            android:textSize="11sp"
            android:backgroundTint="@color/primary"
            android:visibility="gone"
            android:contentDescription="Select reading voice" />

        <TextView
            android:id="@+id/aiStatusText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=""
            android:textColor="@color/accent"
            android:textSize="10sp"
            android:gravity="end"
            android:layout_marginTop="4dp" />

        <TextView
            android:id="@+id/listeningIndicator"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Say Hey Reader"
            android:textColor="@color/accent"
            android:textSize="11sp"
            android:background="@color/status_bg"
            android:paddingHorizontal="8dp"
            android:paddingVertical="4dp"
            android:visibility="gone"
            android:layout_marginTop="4dp" />

    </LinearLayout>

    <!-- Status text overlay bottom of preview -->
    <TextView
        android:id="@+id/statusText"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/status_ready"
        android:textColor="@color/white"
        android:textSize="16sp"
        android:gravity="center"
        android:background="@color/status_bg"
        android:paddingHorizontal="16dp"
        android:paddingVertical="10dp"
        app:layout_constraintBottom_toTopOf="@id/controlPanel"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Control panel at the bottom -->
    <LinearLayout
        android:id="@+id/controlPanel"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@color/primary_dark"
        android:paddingVertical="16dp"
        android:paddingHorizontal="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Capture button - large and prominent -->
        <Button
            android:id="@+id/captureButton"
            android:layout_width="match_parent"
            android:layout_height="72dp"
            android:text="@string/capture_page"
            android:textSize="22sp"
            android:textStyle="bold"
            android:backgroundTint="@color/capture_btn"
            android:contentDescription="Capture and read the current page"
            android:layout_marginBottom="12dp" />

        <!-- Pause/Resume, Stop, and Mic row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/pauseResumeButton"
                android:layout_width="0dp"
                android:layout_height="60dp"
                android:layout_weight="1"
                android:text="@string/pause"
                android:textSize="16sp"
                android:backgroundTint="@color/pause_btn"
                android:enabled="false"
                android:contentDescription="Pause or resume reading"
                android:layout_marginEnd="6dp" />

            <Button
                android:id="@+id/stopButton"
                android:layout_width="0dp"
                android:layout_height="60dp"
                android:layout_weight="1"
                android:text="@string/stop"
                android:textSize="16sp"
                android:backgroundTint="@color/stop_btn"
                android:enabled="false"
                android:contentDescription="Stop reading"
                android:layout_marginStart="6dp"
                android:layout_marginEnd="6dp" />

            <!-- Mic button: tap to listen for one voice command -->
            <Button
                android:id="@+id/micButton"
                android:layout_width="0dp"
                android:layout_height="60dp"
                android:layout_weight="1"
                android:text="🎤"
                android:textSize="22sp"
                android:backgroundTint="@color/primary"
                android:contentDescription="Tap to give a voice command"
                android:layout_marginStart="6dp" />

        </LinearLayout>

        <!-- Listening status (shown when mic is active) -->
        <TextView
            android:id="@+id/listeningIndicator"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Listening..."
            android:textColor="@color/accent"
            android:textSize="13sp"
            android:gravity="center"
            android:layout_marginTop="6dp"
            android:visibility="gone" />

        <!-- Voice command hint -->
        <TextView
            android:id="@+id/voiceHintText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Tap 🎤 then say: pause, resume, stop, previous sentence, last 5 words, read page"
            android:textColor="#AAFFFFFF"
            android:textSize="11sp"
            android:gravity="center"
            android:layout_marginTop="4dp" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
